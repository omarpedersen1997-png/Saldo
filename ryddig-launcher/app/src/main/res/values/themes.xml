<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Viser telefonens baggrundsbillede bag startskærmen -->
    <style name="Theme.RyddigStart" parent="@android:style/Theme.DeviceDefault.Wallpaper.NoTitleBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.RyddigStart.Invisible" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowNoDisplay">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <style name="Theme.RyddigStart.Dialog" parent="@android:style/Theme.DeviceDefault.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    <color name="ic_launcher_background">#1E3A5F</color>
</resources>
